# Copy to .env and fill in real values. Never commit the real .env file.

# Required for live GenAI explanations. Without it, the app runs fine using
# a deterministic template explanation instead.
OPENAI_API_KEY=sk-...

# Optional — defaults shown.
OPENAI_MODEL=gpt-4o-mini
GENAI_TIMEOUT_SECONDS=20
RANDOM_SEED=42
API_HOST=0.0.0.0
API_PORT=8000
